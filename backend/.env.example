# --- LLM (optional) ---
# If unset, DEALMIND falls back to a deterministic rule-based strategy engine
# so the whole app works offline / without any API keys.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# --- Hindsight (optional) ---
# If unset, DEALMIND uses its own built-in local Hindsight-compatible memory
# store (backend/app/hindsight/local_store.py) backed by the same SQLite DB.
# Point these at a real Hindsight Cloud project to swap in the real thing --
# no other code changes needed, see app/hindsight/client.py
HINDSIGHT_API_KEY=
HINDSIGHT_BASE_URL=https://api.hindsight.vectorize.io
HINDSIGHT_COLLECTION=default_bank_id

# --- App ---
DATABASE_URL=sqlite:///./dealmind.db
CORS_ORIGINS=http://localhost:5173
